# === 現場版 .env（複製到 backend/.env）===
# 到現場後根據實際 IP 修改

# InfluxDB（改成現場電腦的 localhost）
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=（到現場建 bucket 後產生的 token）
INFLUX_ORG=SCADA_hushan
INFLUX_BUCKET=real_time_data
INFLUX_BUCKET_AGGREGATED=aggregated_data

# Flask
FLASK_PORT=5051
FLASK_DEBUG=0
PLANT_ID=hushan
